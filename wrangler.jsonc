{
  "name": "physle",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "gravle.app", "custom_domain": true },
    { "pattern": "www.gravle.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/days/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "physle", "database_id": "aab4a57b-ee0d-46f3-ac35-2ec68b622dd1" }
  ],
  "triggers": { "crons": ["0 4 * * *", "*/5 16 * * *", "*/5 20 * * *"] },
  "vars": { "TIMEZONE": "Europe/Madrid", "FIREBASE_PROJECT_ID": "physle" }
}
